{
  "name": "@libre-ai/contracts",
  "version": "0.1.0",
  "description": "TypeScript SDK projection of the Libre AI locked contracts \u2014 fail-closed validators and generated types (sdk-ts, layer 4).",
  "license": "Apache-2.0",
  "types": "./src/index.ts",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "schemas",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "keywords": [
    "libre-ai",
    "sdk",
    "contracts",
    "json-schema",
    "typescript"
  ],
  "homepage": "https://libre-ai.fr",
  "repository": {
    "type": "git",
    "url": "https://github.com/libre-ai/sdk-ts.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./generated/*": "./src/generated/*"
  },
  "scripts": {
    "check:bun": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-bun-manifests.ts",
    "generate": "bun run check:bun:runtime && bun scripts/generate-types.ts",
    "generate:check": "bun run check:bun:runtime && bun scripts/generate-types.ts --check && bun scripts/sync-schemas.ts --check",
    "schemas:sync": "bun run check:bun:runtime && bun scripts/sync-schemas.ts",
    "pretest": "bun run check:bun",
    "test": "bun test",
    "check:bun:runtime": "bun node_modules/@libre-ai/governance/tools/quality/check-bun-minimum.ts",
    "check:toolchain": "bun run check:bun && bun node_modules/@libre-ai/governance/tools/quality/check-toolchain.ts",
    "check:secret-scan": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-secret-scan.ts",
    "check:personal-data": "bun run check:bun:runtime && bun node_modules/@libre-ai/governance/tools/quality/check-personal-data-boundary.ts",
    "lint": "bun run check:bun:runtime && biome ci .",
    "typecheck": "bun run check:bun:runtime && tsc --noEmit -p tsconfig.json",
    "check": "bun run check:bun && bun run check:toolchain && bun run generate:check && bun run check:secret-scan && bun run check:personal-data && bun run lint && bun run typecheck && bun test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1"
  },
  "devDependencies": {
    "@libre-ai/governance": "github:libre-ai/governance#2531f6a16c780bb74ac20541588c80e1386f0e62",
    "@libre-ai/contracts-authority": "github:libre-ai/contracts#64092261884df4ef2fb0220c36227c4bad05956e",
    "@biomejs/biome": "2.5.3",
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  },
  "packageManager": "bun@1.4.0-canary.1",
  "overrides": {
    "fast-uri": "4.1.1"
  }
}
